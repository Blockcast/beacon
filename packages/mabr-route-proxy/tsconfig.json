{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "lib": ["ES2022", "DOM"],
    "declaration": true, "outDir": "./dist", "rootDir": "./src", "composite": true,
    "strict": true, "skipLibCheck": true, "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true, "noImplicitReturns": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*"], "exclude": ["src/**/*.test.ts", "dist"]
}
